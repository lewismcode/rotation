# ── Rotation environment ─────────────────────────────────────────────────────
# Copy to .env (root) for local dev. In Railway, set these as service variables.
# The web service and the worker service both read this same set.

# Postgres
DATABASE_URL=postgres://rotation:rotation@localhost:5432/rotation

# Redis (BullMQ). Railway Redis addon provides this.
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your_cf_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET=rotation
# Optional: override the S3 endpoint. Defaults to
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Clerk (Organizations = labels, Users = artists/staff) — WEB SERVICE ONLY.
# From Clerk dashboard -> your app -> API keys. Publishable = the "Public key"
# (client, inlined at build). Secret = the "default" secret key (server-only).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/batches
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/batches

# ── Worker tuning (optional) ─────────────────────────────────────────────────
# RENDER_CONCURRENCY=2      # concurrent ffmpeg renders (raise with more vCPUs)
# PROBE_CONCURRENCY=4
# X264_PRESET=veryfast      # ultrafast|veryfast|fast|medium — speed vs quality/size
# Pin an IG-accurate bold font for captions (otherwise a system/bundled font is
# used, falling back to generic sans-serif):
# FONT_PATH=/app/apps/worker/assets/fonts/Inter-Bold.ttf
# Override ffmpeg binaries (defaults to the bundled ffmpeg-static):
# FFMPEG_PATH=
# FFPROBE_PATH=

# Deleted batches/clips are archived (hidden, R2 retained) then hard-deleted
# after this many days by the worker's retention purge. Default 30.
# ARCHIVE_RETENTION_DAYS=30

# One-time seed target: point the hook seed at your real Clerk org id.
# SEED_CLERK_ORG_ID=org_xxx
