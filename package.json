{
  "name": "rotation",
  "private": true,
  "version": "0.1.0",
  "description": "Rotation — IG Reels hook overlay system for record labels",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:worker": "npm run dev --workspace apps/worker",
    "db:migrate": "npm run migrate --workspace @rotation/db",
    "db:seed": "npm run seed --workspace @rotation/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^20.17.6"
  }
}
